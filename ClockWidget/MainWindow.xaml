<Window x:Class="ClockWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clock Widget"
        Icon="Assets/AppIcon.ico"
        Width="330"
        Height="118"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
  <Border x:Name="Root"
          Padding="18,10"
          CornerRadius="8"
          Background="#D914171C"
          BorderBrush="#4DFFFFFF"
          BorderThickness="1"
          MouseLeftButtonDown="Root_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18"
                        ShadowDepth="4"
                        Opacity="0.35"
                        Color="#000000" />
    </Border.Effect>
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem x:Name="AlwaysOnTopMenuItem"
                  Header="Always on top"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="AlwaysOnTopMenuItem_Click" />
        <MenuItem x:Name="ShowSecondsMenuItem"
                  Header="Show seconds"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="ShowSecondsMenuItem_Click" />
        <MenuItem x:Name="LockPositionMenuItem"
                  Header="Lock position"
                  IsCheckable="True"
                  Click="LockPositionMenuItem_Click" />
        <Separator />
        <MenuItem Header="Settings..."
                  Click="SettingsMenuItem_Click" />
        <Separator />
        <MenuItem Header="Exit"
                  Click="ExitMenuItem_Click" />
      </ContextMenu>
    </Border.ContextMenu>

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock x:Name="TimeText"
                 FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
                 FontSize="56"
                 FontWeight="SemiBold"
                 Foreground="#FFF8FAFC"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextAlignment="Center"
                 LineStackingStrategy="BlockLineHeight"
                 LineHeight="56" />

      <TextBlock x:Name="DateText"
                 Grid.Row="1"
                 Margin="0,2,0,0"
                 FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
                 FontSize="13"
                 FontWeight="Medium"
                 Foreground="#CCF8FAFC"
                 HorizontalAlignment="Center"
                 TextAlignment="Center" />
    </Grid>
  </Border>
</Window>
