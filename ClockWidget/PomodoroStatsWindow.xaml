<Window x:Class="ClockWidget.PomodoroStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro Stats"
        Icon="Assets/AppIcon.ico"
        Width="820"
        Height="680"
        MinWidth="720"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F8FB"
        FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowTextBrush"
                     Color="#111827" />
    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="#667085" />
    <SolidColorBrush x:Key="PanelBrush"
                     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush"
                     Color="#E3E8EF" />
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#2563EB" />
    <SolidColorBrush x:Key="ControlBorderBrush"
                     Color="#CBD5E1" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle"
           TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize"
              Value="14" />
      <Setter Property="TextWrapping"
              Value="Wrap" />
      <Setter Property="LineHeight"
              Value="20" />
    </Style>

    <Style x:Key="SectionTitleStyle"
           TargetType="TextBlock">
      <Setter Property="FontSize"
              Value="15" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Margin"
              Value="0,0,0,12" />
    </Style>

    <Style x:Key="MetricValueStyle"
           TargetType="TextBlock">
      <Setter Property="FontSize"
              Value="32" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
      <Setter Property="LineHeight"
              Value="36" />
      <Setter Property="LineStackingStrategy"
              Value="BlockLineHeight" />
    </Style>

    <Style x:Key="MetricLabelStyle"
           TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize"
              Value="14" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Margin"
              Value="0,4,0,0" />
    </Style>

    <Style x:Key="SectionCardStyle"
           TargetType="Border">
      <Setter Property="Background"
              Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush"
              Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="8" />
      <Setter Property="Padding"
              Value="16" />
      <Setter Property="Margin"
              Value="0,0,0,12" />
    </Style>

    <Style x:Key="DialogButtonStyle"
           TargetType="Button">
      <Setter Property="Height"
              Value="34" />
      <Setter Property="MinWidth"
              Value="84" />
      <Setter Property="Padding"
              Value="14,0" />
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
      <Setter Property="Background"
              Value="#FFFFFFFF" />
      <Setter Property="BorderBrush"
              Value="{StaticResource ControlBorderBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Cursor"
              Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="#F8FAFC" />
                <Setter TargetName="ButtonSurface"
                        Property="BorderBrush"
                        Value="#94A3B8" />
              </Trigger>
              <Trigger Property="IsPressed"
                       Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="#EEF2F7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActivityNavButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource DialogButtonStyle}">
      <Setter Property="Width"
              Value="34" />
      <Setter Property="MinWidth"
              Value="34" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="FontSize"
              Value="18" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsEnabled"
                 Value="False">
          <Setter Property="Opacity"
                  Value="0.45" />
          <Setter Property="Cursor"
                  Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="RhythmLinkButtonStyle"
           TargetType="Button">
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="Margin"
              Value="0,0,10,0" />
      <Setter Property="Foreground"
              Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Background"
              Value="Transparent" />
      <Setter Property="BorderBrush"
              Value="Transparent" />
      <Setter Property="BorderThickness"
              Value="0" />
      <Setter Property="FontSize"
              Value="15" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Cursor"
              Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter Property="Foreground"
                        Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled"
                       Value="False">
                <Setter Property="Foreground"
                        Value="{StaticResource AccentBrush}" />
                <Setter Property="Cursor"
                        Value="Arrow" />
                <Setter Property="Opacity"
                        Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DeletePomodoroButtonStyle"
           TargetType="Button">
      <Setter Property="Width"
              Value="26" />
      <Setter Property="Height"
              Value="26" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="Foreground"
              Value="#B85A52" />
      <Setter Property="Background"
              Value="Transparent" />
      <Setter Property="BorderBrush"
              Value="Transparent" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="FontSize"
              Value="17" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Cursor"
              Value="Hand" />
      <Setter Property="Opacity"
              Value="0.68" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="DeleteButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="13">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter Property="Opacity"
                        Value="1" />
                <Setter TargetName="DeleteButtonSurface"
                        Property="Background"
                        Value="#FEF3F2" />
                <Setter TargetName="DeleteButtonSurface"
                        Property="BorderBrush"
                        Value="#FECACA" />
              </Trigger>
              <Trigger Property="IsPressed"
                       Value="True">
                <Setter TargetName="DeleteButtonSurface"
                        Property="Background"
                        Value="#FEE4E2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background"
              Value="Transparent" />
      <Setter Property="BorderThickness"
              Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <TabPanel DockPanel.Dock="Top"
                        IsItemsHost="True"
                        ClipToBounds="False"
                        Margin="0,0,0,10" />
              <ContentPresenter ContentSource="SelectedContent" />
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Height"
              Value="38" />
      <Setter Property="MinWidth"
              Value="0" />
      <Setter Property="Margin"
              Value="0,0,4,0" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Foreground"
              Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Cursor"
              Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Height="{TemplateBinding Height}"
                  MinWidth="{TemplateBinding MinWidth}"
                  ClipToBounds="False"
                  SnapsToDevicePixels="True">
              <Border x:Name="TabHoverSurface"
                      Background="Transparent"
                      CornerRadius="6"
                      Margin="0,0,0,4"
                      Padding="4,0">
                <ContentPresenter ContentSource="Header"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="1,0,3,0" />
              </Border>
              <Border x:Name="TabIndicator"
                      Height="3"
                      Background="Transparent"
                      CornerRadius="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      Margin="4,0"
                      IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected"
                       Value="True">
                <Setter TargetName="TabIndicator"
                        Property="Background"
                        Value="#2563EB" />
                <Setter Property="Foreground"
                        Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter TargetName="TabHoverSurface"
                        Property="Background"
                        Value="#F8FAFC" />
              </Trigger>
              <Trigger Property="IsEnabled"
                       Value="False">
                <Setter Property="Opacity"
                        Value="0.45" />
                <Setter Property="Cursor"
                        Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <Border DockPanel.Dock="Bottom"
            Margin="0,2,0,0"
            Background="#FFFFFFFF"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
      <DockPanel LastChildFill="False">
        <Button Content="Reset stats"
                DockPanel.Dock="Left"
                HorizontalAlignment="Left"
                Style="{StaticResource DialogButtonStyle}"
                Foreground="#B42318"
                BorderBrush="#FDA29B"
                ToolTip="Choose which saved Pomodoro statistics to clear"
                Click="ResetStatsButton_Click" />
        <Button Width="86"
                Content="Close"
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Style="{StaticResource DialogButtonStyle}"
                IsDefault="True"
                IsCancel="True"
                Click="CloseButton_Click" />
      </DockPanel>
    </Border>

    <TabControl Margin="0,0,8,0">
      <TabItem Header="Overview">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock x:Name="TodayTitleText"
                       Text="Today"
                       Style="{StaticResource SectionTitleStyle}" />
            <UniformGrid Columns="2"
                         Rows="2">
              <Border Margin="0,0,8,8"
                      Padding="10"
                      Background="#F8FAFC"
                      CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="Today"
                             Style="{StaticResource MetricLabelStyle}"
                             Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="TodayPomodoroCountText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Pomodoro"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="TodayFocusMinutesText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Focus"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Margin="8,0,0,8"
                      Padding="10"
                      Background="#F8FAFC"
                      CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="Week"
                             Style="{StaticResource MetricLabelStyle}"
                             Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="WeekPomodoroCountText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Pomodoro"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="WeekFocusMinutesText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Focus"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Margin="0,8,8,0"
                      Padding="10"
                      Background="#F8FAFC"
                      CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="Month"
                             Style="{StaticResource MetricLabelStyle}"
                             Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="MonthPomodoroCountText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Pomodoro"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="MonthFocusMinutesText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Focus"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Margin="8,8,0,0"
                      Padding="10"
                      Background="#F8FAFC"
                      CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="Year"
                             Style="{StaticResource MetricLabelStyle}"
                             Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="YearPomodoroCountText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Pomodoro"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="YearFocusMinutesText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Focus"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="Activity"
                       Style="{StaticResource SectionTitleStyle}" />
            <Border Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,12"
                           LastChildFill="True">
                  <StackPanel Orientation="Horizontal"
                              DockPanel.Dock="Right"
                              HorizontalAlignment="Right">
                    <Button Content="&lt;"
                            Style="{StaticResource ActivityNavButtonStyle}"
                            ToolTip="Show older activity"
                            Click="ActivityPreviousButton_Click" />
                    <Button x:Name="ActivityNextButton"
                            Content=">"
                            Style="{StaticResource ActivityNavButtonStyle}"
                            Margin="6,0,0,0"
                            ToolTip="Show newer activity"
                            Click="ActivityNextButton_Click" />
                    <Button x:Name="ActivityTodayButton"
                            Content="Today"
                            Style="{StaticResource DialogButtonStyle}"
                            MinWidth="64"
                            Margin="6,0,0,0"
                            ToolTip="Return to the latest 120 days"
                            Click="ActivityTodayButton_Click" />
                  </StackPanel>
                  <TextBlock x:Name="ActivityRangeText"
                             Text="Last 120 days"
                             Foreground="{StaticResource WindowTextBrush}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </DockPanel>
                <Grid x:Name="RecentActivityGrid" />

                <DockPanel Margin="0,12,0,0"
                           LastChildFill="False">
                  <TextBlock Text="Daily focus minutes"
                             DockPanel.Dock="Left"
                             Foreground="{StaticResource MutedTextBrush}"
                             FontSize="13"
                             VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal"
                              DockPanel.Dock="Right"
                              HorizontalAlignment="Right">
                    <TextBlock Text="Less"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#E9EEF5"
                            BorderBrush="#D7DEE8"
                            BorderThickness="1"
                            Margin="0,0,4,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#BDECCB"
                            Margin="0,0,4,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#83D99A"
                            Margin="0,0,4,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#4FBC6A"
                            Margin="0,0,4,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#248B43"
                            Margin="0,0,6,0" />
                    <TextBlock Text="More"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </DockPanel>

                <Border Height="1"
                        Background="#E2E8F0"
                        Margin="0,18,0,16" />

                <DockPanel Margin="0,0,0,12">
                  <WrapPanel DockPanel.Dock="Right"
                             HorizontalAlignment="Right">
                    <Button x:Name="MonthlyMinutesButton"
                            Content="Minutes"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="MonthlyMinutesButton_Click" />
                    <Button x:Name="MonthlyPomodorosButton"
                            Content="Pomodoros"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="MonthlyPomodorosButton_Click" />
                  </WrapPanel>
                  <TextBlock Text="Monthly focus"
                             Foreground="{StaticResource WindowTextBrush}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </DockPanel>
                <Grid x:Name="MonthlyBarsGrid"
                      MinHeight="184" />
              </StackPanel>
            </Border>
          </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Sessions">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Sessions"
                           Style="{StaticResource SectionTitleStyle}"
                           FontSize="18" />
                <TextBlock Text="Focus minutes / pomodoros by hour of day"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="17"
                           Margin="0,0,0,14" />
                <StackPanel Margin="0,0,0,14">
                  <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="Unit:"
                               Style="{StaticResource MetricLabelStyle}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <Button x:Name="RhythmMinutesButton"
                            Content="Minutes"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="RhythmMinutesButton_Click" />
                    <Button x:Name="RhythmPomodorosButton"
                            Content="Pomodoros"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="RhythmPomodorosButton_Click" />
                  </WrapPanel>

                  <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="Mode:"
                               Style="{StaticResource MetricLabelStyle}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <Button x:Name="RhythmAverageButton"
                            Content="Average"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="RhythmAverageButton_Click" />
                    <Button x:Name="RhythmTotalButton"
                            Content="Total"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="RhythmTotalButton_Click" />
                  </WrapPanel>

                  <WrapPanel>
                    <TextBlock Text="Period:"
                               Style="{StaticResource MetricLabelStyle}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <Button x:Name="RhythmAllTimeButton"
                            Content="All time"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="RhythmAllTimeButton_Click" />
                    <Button x:Name="RhythmMonthButton"
                            Content="Month"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="RhythmMonthButton_Click" />
                    <Button x:Name="RhythmWeekButton"
                            Content="Week"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="RhythmWeekButton_Click" />
                    <Button x:Name="RhythmDayButton"
                            Content="Day"
                            Style="{StaticResource RhythmLinkButtonStyle}"
                            Click="RhythmDayButton_Click" />
                  </WrapPanel>
                </StackPanel>
                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                  <Grid x:Name="HourlyRhythmGrid"
                        MinHeight="210" />
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Today"
                             Style="{StaticResource SectionTitleStyle}"
                             FontSize="18"
                             Margin="0" />
                  <WrapPanel x:Name="TodayPomodoroIconsPanel"
                             Grid.Column="1"
                             Margin="10,1,0,0"
                             VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="TodayFocusSessionsPanel" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
