<Window x:Class="ClockWidget.PomodoroStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro Stats"
        Icon="Assets/AppIcon.ico"
        Width="820"
        Height="680"
        MinWidth="720"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F8FB"
        FontFamily="Segoe UI Variable Text, Segoe UI, Arial">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowTextBrush"
                     Color="#111827" />
    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="#667085" />
    <SolidColorBrush x:Key="PanelBrush"
                     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush"
                     Color="#E3E8EF" />
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#2563EB" />
    <SolidColorBrush x:Key="ControlBorderBrush"
                     Color="#CBD5E1" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle"
           TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize"
              Value="14" />
      <Setter Property="TextWrapping"
              Value="Wrap" />
      <Setter Property="LineHeight"
              Value="20" />
    </Style>

    <Style x:Key="SectionTitleStyle"
           TargetType="TextBlock">
      <Setter Property="FontSize"
              Value="15" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Margin"
              Value="0,0,0,12" />
    </Style>

    <Style x:Key="MetricValueStyle"
           TargetType="TextBlock">
      <Setter Property="FontSize"
              Value="32" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
      <Setter Property="LineHeight"
              Value="36" />
      <Setter Property="LineStackingStrategy"
              Value="BlockLineHeight" />
    </Style>

    <Style x:Key="MetricLabelStyle"
           TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize"
              Value="14" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Margin"
              Value="0,4,0,0" />
    </Style>

    <Style x:Key="SectionCardStyle"
           TargetType="Border">
      <Setter Property="Background"
              Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush"
              Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="8" />
      <Setter Property="Padding"
              Value="16" />
      <Setter Property="Margin"
              Value="0,0,0,12" />
    </Style>

    <Style x:Key="DialogButtonStyle"
           TargetType="Button">
      <Setter Property="Height"
              Value="34" />
      <Setter Property="MinWidth"
              Value="84" />
      <Setter Property="Padding"
              Value="14,0" />
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
      <Setter Property="Background"
              Value="#FFFFFFFF" />
      <Setter Property="BorderBrush"
              Value="{StaticResource ControlBorderBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Cursor"
              Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="#F8FAFC" />
                <Setter TargetName="ButtonSurface"
                        Property="BorderBrush"
                        Value="#94A3B8" />
              </Trigger>
              <Trigger Property="IsPressed"
                       Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="#EEF2F7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <Border DockPanel.Dock="Bottom"
            Margin="0,2,0,0"
            Background="#FFFFFFFF"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
      <DockPanel LastChildFill="False">
        <Button Content="Reset stats"
                DockPanel.Dock="Left"
                HorizontalAlignment="Left"
                Style="{StaticResource DialogButtonStyle}"
                Foreground="#B42318"
                BorderBrush="#FDA29B"
                ToolTip="Clear all saved Pomodoro statistics"
                Click="ResetStatsButton_Click" />
        <Button Width="86"
                Content="Close"
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Style="{StaticResource DialogButtonStyle}"
                IsDefault="True"
                IsCancel="True"
                Click="CloseButton_Click" />
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock x:Name="TodayTitleText"
                       Text="Today"
                       Style="{StaticResource SectionTitleStyle}" />
            <UniformGrid Columns="2"
                         Rows="2">
              <Border Margin="0,0,8,8"
                      Padding="10"
                      Background="#F8FAFC"
                      CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="Today"
                             Style="{StaticResource MetricLabelStyle}"
                             Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="TodayPomodoroCountText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Pomodoro"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="TodayFocusMinutesText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Focus"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Margin="8,0,0,8"
                      Padding="10"
                      Background="#F8FAFC"
                      CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="Week"
                             Style="{StaticResource MetricLabelStyle}"
                             Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="WeekPomodoroCountText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Pomodoro"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="WeekFocusMinutesText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Focus"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Margin="0,8,8,0"
                      Padding="10"
                      Background="#F8FAFC"
                      CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="Month"
                             Style="{StaticResource MetricLabelStyle}"
                             Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="MonthPomodoroCountText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Pomodoro"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="MonthFocusMinutesText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Focus"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Margin="8,8,0,0"
                      Padding="10"
                      Background="#F8FAFC"
                      CornerRadius="7">
                <StackPanel>
                  <TextBlock Text="Year"
                             Style="{StaticResource MetricLabelStyle}"
                             Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="YearPomodoroCountText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Pomodoro"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="YearFocusMinutesText"
                                 Style="{StaticResource MetricValueStyle}" />
                      <TextBlock Text="Focus"
                                 Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="Current Timer"
                       Style="{StaticResource SectionTitleStyle}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Text="Phase"
                         Style="{StaticResource MetricLabelStyle}" />
              <TextBlock x:Name="PhaseText"
                         Grid.Row="1"
                         Margin="0,4,12,0"
                         FontSize="20"
                         FontWeight="SemiBold" />

              <TextBlock Grid.Column="1"
                         Text="Remaining"
                         Style="{StaticResource MetricLabelStyle}" />
              <TextBlock x:Name="RemainingText"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,4,0,0"
                         FontSize="20"
                         FontWeight="SemiBold" />
            </Grid>
            <TextBlock x:Name="RunningStateText"
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="Activity"
                       Style="{StaticResource SectionTitleStyle}" />
            <Border Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              <StackPanel>
                <TextBlock Text="Last 120 days"
                           Foreground="{StaticResource WindowTextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <Grid x:Name="RecentActivityGrid" />

                <DockPanel Margin="0,12,0,0"
                           LastChildFill="False">
                  <TextBlock Text="Daily focus minutes"
                             DockPanel.Dock="Left"
                             Foreground="{StaticResource MutedTextBrush}"
                             FontSize="13"
                             VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal"
                              DockPanel.Dock="Right"
                              HorizontalAlignment="Right">
                    <TextBlock Text="Less"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#E9EEF5"
                            BorderBrush="#D7DEE8"
                            BorderThickness="1"
                            Margin="0,0,4,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#BDECCB"
                            Margin="0,0,4,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#83D99A"
                            Margin="0,0,4,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#4FBC6A"
                            Margin="0,0,4,0" />
                    <Border Width="13"
                            Height="13"
                            CornerRadius="4"
                            Background="#248B43"
                            Margin="0,0,6,0" />
                    <TextBlock Text="More"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </DockPanel>

                <Border Height="1"
                        Background="#E2E8F0"
                        Margin="0,18,0,16" />

                <TextBlock Text="Monthly focus"
                           Foreground="{StaticResource WindowTextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <Grid x:Name="MonthlyBarsGrid"
                      MinHeight="184" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
