<Window x:Class="ClockWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clock Settings"
        Icon="Assets/AppIcon.ico"
        Width="440"
        Height="640"
        MinWidth="440"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF3F4F6">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Width="82"
              Height="32"
              Margin="0,0,8,0"
              Content="OK"
              Click="OkButton_Click" />
      <Button Width="82"
              Height="32"
              Margin="0,0,8,0"
              Content="Cancel"
              Click="CancelButton_Click" />
      <Button Width="82"
              Height="32"
              Margin="0,0,8,0"
              Content="Defaults"
              ToolTip="Restore appearance defaults"
              Click="DefaultsButton_Click" />
      <Button x:Name="ApplyButton"
              Width="82"
              Height="32"
              Content="Apply"
              Click="ApplyButton_Click" />
    </StackPanel>

    <TabControl>
      <TabItem Header="Presets">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0">
            <TextBlock Text="Preset name"
                       FontWeight="SemiBold" />
            <TextBox x:Name="PresetNameTextBox"
                     Height="30"
                     Margin="0,4,0,8"
                     TextChanged="PresetNameTextBox_TextChanged" />

            <ComboBox x:Name="PresetComboBox"
                      Height="30"
                      Margin="0,0,0,8"
                      SelectionChanged="PresetComboBox_SelectionChanged" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,4">
              <Button x:Name="SavePresetButton"
                      Width="112"
                      Height="30"
                      Margin="0,0,8,0"
                      Content="Save"
                      Click="SavePresetButton_Click" />
              <Button Width="82"
                      Height="30"
                      Margin="0,0,8,0"
                      Content="Load"
                      Click="LoadPresetButton_Click" />
              <Button x:Name="DeletePresetButton"
                      Width="82"
                      Height="30"
                      Content="Delete"
                      Click="DeletePresetButton_Click" />
            </StackPanel>

            <TextBlock x:Name="PresetKindText"
                       Foreground="#FF4B5563"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,2,0,8" />

            <TextBlock Text="Save stores the current visual settings. Load updates the controls. Use Apply or OK to commit changes."
                       Foreground="#FF4B5563"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Appearance">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0">
            <CheckBox x:Name="ShowBorderCheckBox"
                      Content="Show border"
                      Margin="0,0,0,14"
                      Checked="SettingControl_Changed"
                      Unchecked="SettingControl_Changed" />

            <TextBlock x:Name="BackgroundShadeLabel"
                       FontWeight="SemiBold" />
            <Slider x:Name="BackgroundShadeSlider"
                    Minimum="0"
                    Maximum="80"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />
            <TextBlock Text="0 is pure black, higher values make the black surface softer."
                       Foreground="#FF4B5563"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="BackgroundOpacityLabel"
                       FontWeight="SemiBold" />
            <Slider x:Name="BackgroundOpacitySlider"
                    Minimum="20"
                    Maximum="100"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <Separator Margin="0,18,0,16" />

            <TextBlock Text="Weekday and date"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <CheckBox x:Name="ShowDateCheckBox"
                      Content="Show date"
                      Margin="0,0,0,8"
                      Checked="ShowDateCheckBox_Changed"
                      Unchecked="ShowDateCheckBox_Changed" />

            <CheckBox x:Name="ShowWeekdayCheckBox"
                      Content="Show weekday"
                      Margin="0,0,0,12"
                      Checked="SettingControl_Changed"
                      Unchecked="SettingControl_Changed" />

            <TextBlock x:Name="DateFontSizeLabel"
                       FontWeight="SemiBold" />
            <Slider x:Name="DateFontSizeSlider"
                    Minimum="8"
                    Maximum="42"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <Separator Margin="0,18,0,16" />

            <TextBlock Text="Padding"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="PaddingHorizontalLabel"
                       FontWeight="SemiBold" />
            <Slider x:Name="PaddingHorizontalSlider"
                    Minimum="0"
                    Maximum="40"
                    TickFrequency="0.5"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <TextBlock x:Name="PaddingTopLabel"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0" />
            <Slider x:Name="PaddingTopSlider"
                    Minimum="0"
                    Maximum="40"
                    TickFrequency="0.5"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <TextBlock x:Name="PaddingBottomLabel"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0" />
            <Slider x:Name="PaddingBottomSlider"
                    Minimum="0"
                    Maximum="40"
                    TickFrequency="0.5"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <Separator Margin="0,18,0,16" />

            <TextBlock Text="Size"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <CheckBox x:Name="FitToContentCheckBox"
                      Content="Fit window to content"
                      Margin="0,0,0,14"
                      Checked="FitToContentCheckBox_Changed"
                      Unchecked="FitToContentCheckBox_Changed" />

            <TextBlock x:Name="WidthLabel"
                       FontWeight="SemiBold" />
            <Slider x:Name="WidthSlider"
                    Minimum="120"
                    Maximum="620"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <TextBlock x:Name="HeightLabel"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0" />
            <Slider x:Name="HeightSlider"
                    Minimum="42"
                    Maximum="260"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <TextBlock x:Name="ClockFontSizeLabel"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0" />
            <Slider x:Name="ClockFontSizeSlider"
                    Minimum="32"
                    Maximum="120"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <TextBlock x:Name="ClockFontWeightLabel"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0" />
            <Slider x:Name="ClockFontWeightSlider"
                    Minimum="300"
                    Maximum="900"
                    TickFrequency="100"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Pomodoro">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0">
            <CheckBox x:Name="PomodoroEnabledCheckBox"
                      Content="Enable Pomodoro"
                      Margin="0,0,0,14"
                      Checked="PomodoroEnabledCheckBox_Changed"
                      Unchecked="PomodoroEnabledCheckBox_Changed" />

            <TextBlock x:Name="PomodoroFocusMinutesLabel"
                       FontWeight="SemiBold" />
            <Slider x:Name="PomodoroFocusMinutesSlider"
                    Minimum="1"
                    Maximum="120"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <TextBlock x:Name="PomodoroBreakMinutesLabel"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0" />
            <Slider x:Name="PomodoroBreakMinutesSlider"
                    Minimum="1"
                    Maximum="60"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged" />

            <CheckBox x:Name="PomodoroAutoStartBreakCheckBox"
                      Content="Auto-start break after focus"
                      Margin="0,10,0,8"
                      Checked="SettingControl_Changed"
                      Unchecked="SettingControl_Changed" />

            <CheckBox x:Name="PomodoroReturnToClockCheckBox"
                      Content="Return to clock after break"
                      Margin="0,0,0,8"
                      Checked="SettingControl_Changed"
                      Unchecked="SettingControl_Changed" />

            <CheckBox x:Name="PomodoroPlaySoundCheckBox"
                      Content="Play sound when timer ends"
                      Margin="0,0,0,8"
                      Checked="SettingControl_Changed"
                      Unchecked="SettingControl_Changed" />

            <TextBlock Text="Timer sound"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,14">
              <ComboBox x:Name="PomodoroSoundComboBox"
                        Width="210"
                        Height="30"
                        Margin="0,0,8,0"
                        SelectionChanged="SettingControl_Changed" />
              <Button x:Name="PomodoroSoundPreviewButton"
                      Width="82"
                      Height="30"
                      Content="Preview"
                      Click="PomodoroSoundPreviewButton_Click" />
            </StackPanel>

            <TextBlock Text="Ctrl-click the widget to switch clock/Pomodoro. Pomodoro controls appear on the widget."
                       Foreground="#FF4B5563"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="System">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0">
            <CheckBox x:Name="StartWithWindowsCheckBox"
                      Content="Start with Windows"
                      Margin="0,0,0,8"
                      Checked="SettingControl_Changed"
                      Unchecked="SettingControl_Changed" />

            <CheckBox x:Name="SnapToScreenEdgesCheckBox"
                      Content="Snap to screen edges"
                      Margin="0,0,0,14"
                      Checked="SettingControl_Changed"
                      Unchecked="SettingControl_Changed" />

            <Separator Margin="0,10,0,16" />

            <TextBlock Text="Settings file"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
              <Button Width="82"
                      Height="30"
                      Margin="0,0,8,0"
                      Content="Import"
                      Click="ImportSettingsButton_Click" />
              <Button Width="82"
                      Height="30"
                      Content="Export"
                      Click="ExportSettingsButton_Click" />
            </StackPanel>

            <TextBlock Text="Import updates this dialog draft. Use Apply or OK to commit changes."
                       Foreground="#FF4B5563"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
