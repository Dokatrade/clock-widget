<Window x:Class="ClockWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clock Settings"
        Icon="Assets/AppIcon.ico"
        Width="500"
        Height="620"
        MinWidth="460"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F8FB"
        FontFamily="Segoe UI Variable Text, Segoe UI, Arial">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowTextBrush"
                     Color="#111827" />
    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="#667085" />
    <SolidColorBrush x:Key="PanelBrush"
                     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush"
                     Color="#E3E8EF" />
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="#1D4ED8" />
    <SolidColorBrush x:Key="ControlBorderBrush"
                     Color="#CBD5E1" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle"
           TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize"
              Value="12" />
      <Setter Property="TextWrapping"
              Value="Wrap" />
      <Setter Property="LineHeight"
              Value="17" />
    </Style>

    <Style x:Key="SectionTitleStyle"
           TargetType="TextBlock">
      <Setter Property="FontSize"
              Value="15" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Margin"
              Value="0,0,0,12" />
    </Style>

    <Style x:Key="FieldLabelStyle"
           TargetType="TextBlock">
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Margin"
              Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionCardStyle"
           TargetType="Border">
      <Setter Property="Background"
              Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush"
              Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="8" />
      <Setter Property="Padding"
              Value="16" />
      <Setter Property="Margin"
              Value="0,0,0,12" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height"
              Value="34" />
      <Setter Property="Padding"
              Value="10,5" />
      <Setter Property="BorderBrush"
              Value="{StaticResource ControlBorderBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="Background"
              Value="#FFFFFFFF" />
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
      <Setter Property="VerticalContentAlignment"
              Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height"
              Value="34" />
      <Setter Property="Padding"
              Value="8,4" />
      <Setter Property="BorderBrush"
              Value="{StaticResource ControlBorderBrush}" />
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
      <Setter Property="VerticalContentAlignment"
              Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
      <Setter Property="Margin"
              Value="0,0,0,10" />
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Margin"
              Value="0,0,0,10" />
    </Style>

    <Style x:Key="DialogButtonStyle"
           TargetType="Button">
      <Setter Property="Height"
              Value="34" />
      <Setter Property="MinWidth"
              Value="84" />
      <Setter Property="Padding"
              Value="14,0" />
      <Setter Property="Foreground"
              Value="{StaticResource WindowTextBrush}" />
      <Setter Property="Background"
              Value="#FFFFFFFF" />
      <Setter Property="BorderBrush"
              Value="{StaticResource ControlBorderBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Cursor"
              Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="#F8FAFC" />
                <Setter TargetName="ButtonSurface"
                        Property="BorderBrush"
                        Value="#94A3B8" />
              </Trigger>
              <Trigger Property="IsPressed"
                       Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsEnabled"
                       Value="False">
                <Setter Property="Opacity"
                        Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource DialogButtonStyle}">
      <Setter Property="Foreground"
              Value="#FFFFFFFF" />
      <Setter Property="Background"
              Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush"
              Value="{StaticResource AccentBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="{StaticResource AccentHoverBrush}" />
                <Setter TargetName="ButtonSurface"
                        Property="BorderBrush"
                        Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed"
                       Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="#1E40AF" />
              </Trigger>
              <Trigger Property="IsEnabled"
                       Value="False">
                <Setter Property="Opacity"
                        Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background"
              Value="Transparent" />
      <Setter Property="BorderThickness"
              Value="0" />
      <Setter Property="Padding"
              Value="0" />
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground"
              Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Padding"
              Value="12,8" />
      <Setter Property="Margin"
              Value="0,0,6,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid>
              <Border x:Name="TabSurface"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter TargetName="TabSurface"
                        Property="Background"
                        Value="#EEF2FF" />
                <Setter Property="Foreground"
                        Value="#1E3A8A" />
              </Trigger>
              <Trigger Property="IsSelected"
                       Value="True">
                <Setter TargetName="TabSurface"
                        Property="Background"
                        Value="#FFFFFFFF" />
                <Setter TargetName="TabSurface"
                        Property="BorderBrush"
                        Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="Foreground"
                        Value="#1D4ED8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <Border DockPanel.Dock="Bottom"
            Margin="0,14,0,0"
            Background="#FFFFFFFF"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <Button Width="86"
                Margin="0,0,8,0"
                Content="OK"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="OkButton_Click" />
        <Button Width="86"
                Margin="0,0,8,0"
                Content="Cancel"
                Style="{StaticResource DialogButtonStyle}"
                Click="CancelButton_Click" />
        <Button Width="90"
                Margin="0,0,8,0"
                Content="Defaults"
                ToolTip="Restore appearance defaults"
                Style="{StaticResource DialogButtonStyle}"
                Click="DefaultsButton_Click" />
        <Button x:Name="ApplyButton"
                Width="86"
                Content="Apply"
                Style="{StaticResource DialogButtonStyle}"
                Click="ApplyButton_Click" />
      </StackPanel>
    </Border>

    <TabControl>
      <TabItem Header="Presets">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0">
            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Presets"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Preset name"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="PresetNameTextBox"
                         Margin="0,0,0,10"
                         TextChanged="PresetNameTextBox_TextChanged" />

                <ComboBox x:Name="PresetComboBox"
                          Margin="0,0,0,10"
                          SelectionChanged="PresetComboBox_SelectionChanged" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                  <Button x:Name="SavePresetButton"
                          Width="124"
                          Margin="0,0,8,0"
                          Content="Save"
                          Style="{StaticResource DialogButtonStyle}"
                          Click="SavePresetButton_Click" />
                  <Button Width="86"
                          Margin="0,0,8,0"
                          Content="Load"
                          Style="{StaticResource DialogButtonStyle}"
                          Click="LoadPresetButton_Click" />
                  <Button x:Name="DeletePresetButton"
                          Width="86"
                          Content="Delete"
                          Style="{StaticResource DialogButtonStyle}"
                          Click="DeletePresetButton_Click" />
                </StackPanel>

                <TextBlock x:Name="PresetKindText"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,0,0,8" />

                <TextBlock Text="Save stores the current visual settings. Load updates the controls. Use Apply or OK to commit changes."
                           Style="{StaticResource MutedTextStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Appearance">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0">
            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Surface"
                           Style="{StaticResource SectionTitleStyle}" />
                <CheckBox x:Name="ShowBorderCheckBox"
                          Content="Show border"
                          Checked="SettingControl_Changed"
                          Unchecked="SettingControl_Changed" />

                <TextBlock x:Name="BackgroundShadeLabel"
                           Style="{StaticResource FieldLabelStyle}" />
                <Slider x:Name="BackgroundShadeSlider"
                        Minimum="0"
                        Maximum="80"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />
                <TextBlock Text="0 is pure black, higher values make the black surface softer."
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,-4,0,12" />

                <TextBlock x:Name="BackgroundOpacityLabel"
                           Style="{StaticResource FieldLabelStyle}" />
                <Slider x:Name="BackgroundOpacitySlider"
                        Minimum="20"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Weekday and date"
                           Style="{StaticResource SectionTitleStyle}" />

                <CheckBox x:Name="ShowDateCheckBox"
                          Content="Show date"
                          Checked="ShowDateCheckBox_Changed"
                          Unchecked="ShowDateCheckBox_Changed" />

                <CheckBox x:Name="ShowWeekdayCheckBox"
                          Content="Show weekday"
                          Checked="SettingControl_Changed"
                          Unchecked="SettingControl_Changed" />

                <TextBlock x:Name="DateFontSizeLabel"
                           Style="{StaticResource FieldLabelStyle}" />
                <Slider x:Name="DateFontSizeSlider"
                        Minimum="8"
                        Maximum="42"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Padding"
                           Style="{StaticResource SectionTitleStyle}" />

                <TextBlock x:Name="PaddingHorizontalLabel"
                           Style="{StaticResource FieldLabelStyle}" />
                <Slider x:Name="PaddingHorizontalSlider"
                        Minimum="0"
                        Maximum="40"
                        TickFrequency="0.5"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />

                <TextBlock x:Name="PaddingTopLabel"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,8,0,4" />
                <Slider x:Name="PaddingTopSlider"
                        Minimum="0"
                        Maximum="40"
                        TickFrequency="0.5"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />

                <TextBlock x:Name="PaddingBottomLabel"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,8,0,4" />
                <Slider x:Name="PaddingBottomSlider"
                        Minimum="0"
                        Maximum="40"
                        TickFrequency="0.5"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Size"
                           Style="{StaticResource SectionTitleStyle}" />

                <CheckBox x:Name="FitToContentCheckBox"
                          Content="Fit window to content"
                          Checked="FitToContentCheckBox_Changed"
                          Unchecked="FitToContentCheckBox_Changed" />

                <TextBlock x:Name="WidthLabel"
                           Style="{StaticResource FieldLabelStyle}" />
                <Slider x:Name="WidthSlider"
                        Minimum="120"
                        Maximum="620"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />

                <TextBlock x:Name="HeightLabel"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,8,0,4" />
                <Slider x:Name="HeightSlider"
                        Minimum="42"
                        Maximum="260"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />

                <TextBlock x:Name="ClockFontSizeLabel"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,8,0,4" />
                <Slider x:Name="ClockFontSizeSlider"
                        Minimum="32"
                        Maximum="120"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />

                <TextBlock x:Name="ClockFontWeightLabel"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,8,0,4" />
                <Slider x:Name="ClockFontWeightSlider"
                        Minimum="300"
                        Maximum="900"
                        TickFrequency="100"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Pomodoro">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0">
            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Timer"
                           Style="{StaticResource SectionTitleStyle}" />
                <CheckBox x:Name="PomodoroEnabledCheckBox"
                          Content="Enable Pomodoro"
                          Checked="PomodoroEnabledCheckBox_Changed"
                          Unchecked="PomodoroEnabledCheckBox_Changed" />

                <TextBlock x:Name="PomodoroFocusMinutesLabel"
                           Style="{StaticResource FieldLabelStyle}" />
                <Slider x:Name="PomodoroFocusMinutesSlider"
                        Minimum="1"
                        Maximum="120"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />

                <TextBlock x:Name="PomodoroBreakMinutesLabel"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,8,0,4" />
                <Slider x:Name="PomodoroBreakMinutesSlider"
                        Minimum="1"
                        Maximum="60"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />

                <TextBlock x:Name="PomodoroLongBreakIntervalLabel"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,8,0,4" />
                <Slider x:Name="PomodoroLongBreakIntervalSlider"
                        Minimum="1"
                        Maximum="20"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />

                <TextBlock x:Name="PomodoroLongBreakMinutesLabel"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,8,0,4" />
                <Slider x:Name="PomodoroLongBreakMinutesSlider"
                        Minimum="1"
                        Maximum="60"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Behavior"
                           Style="{StaticResource SectionTitleStyle}" />
                <CheckBox x:Name="PomodoroAutoStartBreakCheckBox"
                          Content="Auto-start break after focus"
                          Checked="SettingControl_Changed"
                          Unchecked="SettingControl_Changed" />

                <CheckBox x:Name="PomodoroReturnToClockCheckBox"
                          Content="Return to clock after break"
                          Checked="SettingControl_Changed"
                          Unchecked="SettingControl_Changed" />

                <CheckBox x:Name="ShowPomodoroDailyStatsCheckBox"
                          Content="Show daily Pomodoro stats"
                          ToolTip="Shows today's Pomodoro count and focus minutes on the widget"
                          Checked="SettingControl_Changed"
                          Unchecked="SettingControl_Changed" />

                <CheckBox x:Name="PomodoroPlaySoundCheckBox"
                          Content="Play sound when timer ends"
                          Checked="SettingControl_Changed"
                          Unchecked="SettingControl_Changed" />

                <TextBlock Text="Timer sound"
                           Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                  <ComboBox x:Name="PomodoroSoundComboBox"
                            Width="238"
                            Margin="0,0,8,0"
                            SelectionChanged="SettingControl_Changed" />
                  <Button x:Name="PomodoroSoundPreviewButton"
                          Width="92"
                          Content="Preview"
                          Style="{StaticResource DialogButtonStyle}"
                          Click="PomodoroSoundPreviewButton_Click" />
                </StackPanel>

                <TextBlock Text="Ctrl-click the widget to switch clock/Pomodoro. Pomodoro controls appear on the widget."
                           Style="{StaticResource MutedTextStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="System">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0">
            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Startup and placement"
                           Style="{StaticResource SectionTitleStyle}" />
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Start with Windows"
                          Checked="SettingControl_Changed"
                          Unchecked="SettingControl_Changed" />

                <CheckBox x:Name="SnapToScreenEdgesCheckBox"
                          Content="Snap to screen edges"
                          Checked="SettingControl_Changed"
                          Unchecked="SettingControl_Changed" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
              <StackPanel>
                <TextBlock Text="Settings file"
                           Style="{StaticResource SectionTitleStyle}" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                  <Button Width="86"
                          Margin="0,0,8,0"
                          Content="Import"
                          Style="{StaticResource DialogButtonStyle}"
                          Click="ImportSettingsButton_Click" />
                  <Button Width="86"
                          Content="Export"
                          Style="{StaticResource DialogButtonStyle}"
                          Click="ExportSettingsButton_Click" />
                </StackPanel>

                <TextBlock Text="Import updates this dialog draft. Use Apply or OK to commit changes."
                           Style="{StaticResource MutedTextStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
